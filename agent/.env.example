# Chép file này thành .env rồi điền giá trị. Không commit file .env thật.

# Bắt buộc. API key của nhà cung cấp tương thích OpenAI (hoặc proxy) đang dùng.
OPENAI_API_KEY=your_api_key_here

# Bắt buộc. Base URL của endpoint tương thích OpenAI, gồm cả phần version.
# Ví dụ: https://api.openai.com/v1  |  http://localhost:4000/v1 (proxy LiteLLM)
OPENAI_BASE_URL=https://api.openai.com/v1

# Bắt buộc. Mã model mà nhà cung cấp đã cấu hình hỗ trợ.
OPENAI_MODEL=your-provider-model-id

# Địa chỉ backend Spring mà agent gọi thay mặt khách.
BACKEND_URL=http://localhost:8080
