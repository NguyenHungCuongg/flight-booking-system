# Sao chép thành .env rồi sửa giá trị (.env không được commit).
# Giá trị ở đây dùng khi chạy backend trực tiếp trên máy (profile dev đọc file này);
# docker-compose.yml tự đổi host sang tên service (postgres, mailpit, ...).

SPRING_PROFILES_ACTIVE=dev

# Đổi DB_PORT và cổng trong DB_URL nếu máy đã có PostgreSQL khác chiếm cổng 5432.
DB_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/flightbooking
DB_USERNAME=flightbooking
DB_PASSWORD=change-me

# Bật khi chạy sau HTTPS để cookie phiên có cờ Secure (NFR-03).
COOKIE_SECURE=false

# SMTP. Khi dev dùng Mailpit (không cần tài khoản), xem email ở http://localhost:8025.
# SMTP thật: thường là cổng 587; backend tự dùng STARTTLS khi server hỗ trợ.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@flightbooking.local

# Địa chỉ frontend, dùng cho link trong email (VD link đặt lại mật khẩu).
APP_BASE_URL=http://localhost:3000

# VNPay sandbox (TDD §6.3). Đăng ký tại https://sandbox.vnpayment.vn/devreg/, VNPay gửi mã và secret qua email.
# Return URL đi qua Next.js (cổng 3000), nên khi thử thanh toán phải chạy cả frontend.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/api/payments/vnpay/return
# Refund API (Plan 14). Staff duyệt hoàn thì backend gọi URL này.
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
